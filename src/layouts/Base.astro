---
import '../styles/global.css';
import { site, nav } from '../data/site.js';
import markRaw from '../../public/brand/mark.svg?raw';
const mark = markRaw.replace('<svg', '<svg class="hdr__mark" aria-hidden="true" focusable="false"');

const { title, description, image = '/media/entrepot.webp', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title ? `${title} — Next Drive, Saint-Béron (73)` : 'Next Drive — Dépôt-vente de voitures d’occasion à Saint-Béron, Savoie';
const dealer = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': `${site.url}/#dealer`,
  name: site.name,
  legalName: site.legal,
  url: site.url,
  image: `${site.url}/media/entrepot.webp`,
  logo: `${site.url}/brand/logo.png`,
  telephone: '+33480799365',
  email: site.email,
  priceRange: '€€',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postal, addressLocality: site.city, addressRegion: site.region, addressCountry: 'FR' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: site.hoursSchema.map((h) => ({ '@type': 'OpeningHoursSpecification', ...h })),
  areaServed: ['Savoie', 'Isère', 'Chambéry', 'Le Pont-de-Beauvoisin', 'Les Échelles', 'Voiron'],
  sameAs: [site.instagram, site.mapsUrl],
  vatID: site.vat,
};
const ld = [dealer, ...schema];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0b0b0c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/brand/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Next Drive" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
  <slot name="head" />
</head>
<body>
  <a class="sr-only" href="#contenu">Aller au contenu</a>
  <header class="hdr" id="hdr">
    <div class="hdr__left">
      <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram de Next Drive">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM12 3.6c2.7 0 3.1 0 4.1.06 2.8.13 4.1 1.45 4.24 4.24.05 1.06.06 1.38.06 4.1s0 3.04-.06 4.1c-.13 2.78-1.43 4.1-4.24 4.24-1.06.05-1.37.06-4.1.06s-3.04 0-4.1-.06c-2.82-.13-4.1-1.47-4.24-4.24C3.6 15.04 3.6 14.72 3.6 12s0-3.04.06-4.1C3.8 5.1 5.1 3.8 7.9 3.66 8.96 3.6 9.28 3.6 12 3.6Z"/></svg>
      </a>
      <a href={site.phoneHref} aria-label={`Appeler Next Drive au ${site.phone}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
      </a>
      <a class="hdr__tel" href={site.phoneHref}>{site.phone}</a>
    </div>
    <a class="hdr__logo" href="/" aria-label="Next Drive — accueil">
      <Fragment set:html={mark} />
      <span class="hdr__word">NEXT&nbsp;DRIVE</span>
    </a>
    <div class="hdr__right">
      <a class="hdr__cta" href="/vendre">Estimation gratuite</a>
      <button class="hdr__menu" id="menuBtn" aria-expanded="false" aria-controls="menu">
        <span class="hdr__menu-label">Naviguer</span>
        <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
        <span class="sr-only">Ouvrir le menu</span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" inert>
    <div class="menu__inner">
      <ol class="menu__list">
        {nav.map((l, i) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}><span>{String(i + 1).padStart(2, '0')}</span>{l.label}</a></li>
        ))}
      </ol>
      <div class="menu__side">
        <div><p class="label">Showroom</p><p>{site.street}<br />{site.postal} {site.city}</p></div>
        <div><p class="label">Téléphone</p><p><a href={site.phoneHref}>{site.phone}</a></p></div>
        <div><p class="label">Visites</p><p>Sur rendez-vous, du mardi au samedi</p></div>
      </div>
    </div>
  </div>

  <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer" id="contact-footer">
    <div class="footer__media" id="footerMedia" aria-hidden="true">
      <img class="footer__dim" src="/media/entrepot.webp" alt="" loading="lazy" />
      <img class="footer__lit" src="/media/entrepot.webp" alt="" loading="lazy" />
    </div>
    <div class="footer__content">
      <span class="label">Prêt à vendre votre voiture ?</span>
      <h2 class="footer__title js-chars">On s’occupe<br />du reste</h2>
      <div class="ctas" style="justify-content:center">
        <a class="cta cta--fill" href="/vendre"><span>Obtenir mon estimation</span><b aria-hidden="true">→</b></a>
        <a class="cta" href="/stock"><span>Voir le stock</span><b aria-hidden="true">→</b></a>
      </div>
    </div>
    <div class="footer__info">
      <div><h4>Showroom</h4><p>{site.street}<br />{site.postal} {site.city} ({site.region})</p><p><a href={site.mapsUrl} target="_blank" rel="noopener">Itinéraire →</a></p></div>
      <div><h4>Contact</h4><ul><li><a href={site.phoneHref}>{site.phone}</a></li><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href={site.instagram} target="_blank" rel="noopener">Instagram @nextdrive_savoie</a></li></ul></div>
      <div><h4>Horaires</h4><ul>{site.hours.map((h) => <li>{h.days} : {h.time}</li>)}</ul></div>
      <div><h4>Pages</h4><ul>{nav.slice(1).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
    </div>
    <div class="footer__bar">
      <span>© 2026 {site.legal} · SIREN {site.siren}</span>
      <nav aria-label="Informations légales">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/credits">Crédits</a>
        <a href="#top">Retour en haut ↑</a>
      </nav>
    </div>
  </footer>

  <script>
    import { initReveals } from '../scripts/core.js';
    initReveals();
  </script>
</body>
</html>
