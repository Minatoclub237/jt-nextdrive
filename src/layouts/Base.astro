---
import '../styles/global.css';
import { site, nav, services } from '../data/site.js';
import logoRaw from '../../public/brand/full.svg?raw';
// vrai logo (voiture + NEXT DRIVE + VOITURES D'OCCASIONS), recadré au plus près du tracé
const logo = (cls) => logoRaw.replace(/<svg[^>]*>/, `<svg class="${cls}" viewBox="71 54 2292 1145" aria-hidden="true" focusable="false">`);

const { title, description, image = '/media/entrepot.webp', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title ? `${title} — Next Drive, Saint-Béron (73)` : 'Next Drive — Dépôt-vente de voitures d’occasion à Saint-Béron, Savoie';
const dealer = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  '@id': `${site.url}/#dealer`,
  name: site.name,
  legalName: site.legal,
  url: site.url,
  image: `${site.url}/media/entrepot.webp`,
  logo: `${site.url}/brand/logo.png`,
  telephone: '+33682717739',
  email: site.email,
  priceRange: '€€',
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.postal, addressLocality: site.city, addressRegion: site.region, addressCountry: 'FR' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: site.hoursSchema.map((h) => ({ '@type': 'OpeningHoursSpecification', ...h })),
  areaServed: ['Savoie', 'Isère', 'Chambéry', 'Le Pont-de-Beauvoisin', 'Les Échelles', 'Voiron'],
  sameAs: [site.instagram, site.mapsUrl],
  vatID: site.vat,
};
const ld = [dealer, ...schema];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0b0b0c" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/brand/logo.png" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Next Drive" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
  <slot name="head" />
</head>
<body>
  <a class="sr-only" href="#contenu">Aller au contenu</a>
  <header class="hdr" id="hdr">
    <a class="hdr__logo" href="/" aria-label="Next Drive — accueil"><Fragment set:html={logo('hdr__mark')} /></a>
    <nav class="hdr__nav" aria-label="Navigation principale">
      <ul>
        {nav.slice(1).map((l) => <li><a href={l.href} aria-current={path === l.href || path.startsWith(l.href + '/') ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="hdr__right">
      <a class="cta cta--fill hdr__cta" href="/vendre"><span>Estimation gratuite</span><b aria-hidden="true">→</b></a>
      <button class="hdr__menu" id="menuBtn" aria-expanded="false" aria-controls="menu">
        <span class="hdr__menu-label">Menu</span>
        <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
        <span class="sr-only">Ouvrir le menu</span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" inert>
    <div class="menu__inner">
      <ol class="menu__list">
        {nav.map((l, i) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}><span>{String(i + 1).padStart(2, '0')}</span>{l.label}</a></li>
        ))}
      </ol>
      <div class="menu__side">
        <div><p class="label">Showroom</p><p>{site.street}<br />{site.postal} {site.city}</p></div>
        <div><p class="label">Téléphone</p><p><a href={site.phoneHref}>{site.phone}</a></p></div>
        <div><p class="label">Visites</p><p>Sur rendez-vous, du mardi au samedi</p></div>
      </div>
    </div>
  </div>

  <a class="callfab" id="callFab" href={site.phoneHref} aria-label={`Appeler Next Drive au ${site.phone}`}>
    <i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg></i>
    <span>{site.phone}</span>
  </a>

  <div class="progress" aria-hidden="true"><i id="progressBar"></i></div>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer" id="contact-footer">
    <div class="footer__hero">
    <div class="footer__media" id="footerMedia" aria-hidden="true">
      <img class="footer__dim" src="/media/entrepot.webp" alt="" loading="lazy" />
      <img class="footer__lit" src="/media/entrepot.webp" alt="" loading="lazy" />
    </div>
    <div class="footer__content">
      <span class="label">Prêt à vendre votre voiture ?</span>
      <h2 class="footer__title js-chars">On s’occupe<br />du reste</h2>
      <div class="ctas" style="justify-content:center">
        <a class="cta cta--fill" href="/vendre"><span>Obtenir mon estimation</span><b aria-hidden="true">→</b></a>
        <a class="cta" href="/stock"><span>Voir le stock</span><b aria-hidden="true">→</b></a>
      </div>
    </div>
    </div>
    <div class="footer__main">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label="Next Drive — accueil"><Fragment set:html={logo('footer__mark')} /></a>
        <p>Confiez-nous votre véhicule et profitez d’une vente sécurisée, simple et au meilleur prix. Dépôt-vente et intermédiation à Saint-Béron, en Savoie.</p>
        <a class="footer__rating" href={site.mapsUrl} target="_blank" rel="noopener"><b>{site.rating.value}</b><span class="stars" aria-hidden="true">★★★★★</span><span>{site.rating.count} avis Google</span></a>
        <ul class="footer__social" aria-label="Next Drive sur les réseaux">
          <li><a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram @nextdrive_savoie"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg></a></li>
          <li><a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn Next Drive"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.84-2.05 3.78-2.05 4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H9z"/></svg></a></li>
          <li><a href={site.mapsUrl} target="_blank" rel="noopener" aria-label="Fiche Google Maps de Next Drive"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/></svg></a></li>
        </ul>
      </div>
      <div><h4>Navigation</h4><ul>{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul></div>
      <div><h4>Services</h4><ul>{services.map((x) => <li><a href={`/services#${x.key}`}>{x.title}</a></li>)}</ul></div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.street}<br />{site.postal} {site.city} ({site.region})</li>
          <li><a class="footer__link" href={site.mapsUrl} target="_blank" rel="noopener">Itinéraire →</a></li>
        </ul>
      </div>
      <div>
        <h4>Horaires</h4>
        <ul class="footer__hours">{site.hours.map((h) => <li><span>{h.days}</span><span>{h.time}</span></li>)}</ul>
        <p class="footer__note">Visites et essais sur rendez-vous.</p>
      </div>
    </div>
    <div class="footer__bar">
      <p>© 2026 {site.legal} · SAS au capital de {site.capital} · SIREN {site.siren} · TVA {site.vat}</p>
      <nav aria-label="Informations légales">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/confidentialite">Confidentialité</a>
        <a href="/credits">Crédits</a>
        <a href="#top">Retour en haut ↑</a>
      </nav>
    </div>
  </footer>

  <script>
    import { initReveals } from '../scripts/core.js';
    initReveals();
  </script>
</body>
</html>
