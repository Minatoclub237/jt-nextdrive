---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="phero" id="top">
    <div class="phero__media"><img src="/media/rs6-phare.webp" alt="" /></div>
    <div class="phero__inner">
      <span class="label">Erreur 404</span>
      <h1 class="js-chars">Hors piste</h1>
      <p>Cette page n’existe pas, ou la voiture a déjà trouvé preneur.</p>
      <div class="ctas"><a class="cta cta--fill" href="/stock"><span>Voir le stock</span><b aria-hidden="true">→</b></a><a class="cta" href="/"><span>Accueil</span><b aria-hidden="true">→</b></a></div>
    </div>
  </section>
</Base>
